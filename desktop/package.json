{
  "name": "inkwell",
  "productName": "Inkwell",
  "version": "1.3.0",
  "description": "Inkwell: a fast PDF viewer and editor",
  "author": "Ali Khalid",
  "license": "MIT",
  "private": true,
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "predist": "npm --prefix .. run build",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "local.inkwell.app",
    "productName": "Inkwell",
    "files": [
      "app/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "art"
    },
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "art/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Inkwell",
      "artifactName": "Inkwell Setup.exe",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "Inkwell.PDF",
        "description": "PDF document",
        "icon": "art/doc.ico",
        "role": "Editor"
      }
    ],
    "publish": null,
    "compression": "maximum",
    "extraResources": [
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true,
      "grantFileProtocolExtraPrivileges": false
    }
  }
}
